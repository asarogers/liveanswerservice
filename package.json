{
  "name": "liveanswerservice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-image-manifest.mjs && node scripts/generate-guides-manifest.mjs && node scripts/fetch-google-reviews.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "node scripts/deploy.mjs",
    "postdeploy": "node scripts/request-indexing.mjs",
    "index": "node scripts/request-indexing.mjs",
    "index:all": "node scripts/request-indexing.mjs --all",
    "index:priority": "node scripts/request-indexing.mjs --all --priority",
    "index:dry": "node scripts/request-indexing.mjs --dry",
    "index:ping": "node scripts/request-indexing.mjs --ping",
    "fallbacks": "node scripts/find-fallback-locations.mjs",
    "fallbacks:json": "node scripts/find-fallback-locations.mjs --json",
    "fallbacks:queue": "node scripts/find-fallback-locations.mjs --queue"
