# Cloudflare Workers local secrets — GITIGNORED, do NOT commit.
# Format is .env-style (KEY=value). This file is what `wrangler dev` reads locally.
# For PRODUCTION each of these must ALSO be set on the deployed Worker via:
#     wrangler secret put RETELL_API_KEY
#
# ── Retell (outbound AI demo calls) ───────────────────────────
# Paste your Retell API key after the = (no quotes, no spaces). Settings → API keys.
RETELL_API_KEY=key_f49343333ebd97ff99d36fa86d46
# Non-secret config (these can also live in wrangler.toml [vars]):
RETELL_FROM_NUMBER=+16693161742
RETELL_OUTBOUND_AGENT_ID=agent_0ad6f3400c9549a0837a048594
# Webhook signing key — the Retell key with the "webhook" badge (may differ from
# the API-call key above). Used to verify x-retell-signature. Falls back to
# RETELL_API_KEY if unset. Paste the webhook-badge key here:
# RETELL_WEBHOOK_API_KEY=key_xxx

# Master gate for placing real outbound calls locally. Keep "false" unless you
# want `wrangler dev` to actually dial via Retell.
DEMO_CALL_LIVE=false

# ── Lead store (Hetzner VPS, reuses the /api/receipt server) ──────────
# Base URL + bearer token for POST {base}/api/leads and /api/leads/update.
# If unset, lead persistence is skipped (calls still place; owner still emailed).
# LEADS_INGEST_URL=https://audit.assurgit.com
# LEADS_INGEST_TOKEN=

# ── Cal.com (Retell Book Calendar tool — embedded in the agent's tool config) ──
# Event types: 5041168 = 30-min setup call, 5041170 = 15-min. Rotate after launch (OPEN-ITEMS #28).
CALCOM_API_KEY=cal_live_9f8579e5097d704cec790d78d259d67d
CALCOM_EVENT_TYPE_30MIN=5041168
CALCOM_EVENT_TYPE_15MIN=5041170

# ── Existing site secrets (fill only if running the site locally) ──
# RESEND_API_KEY=re_LWWVSbb8_KNP1Nr7nAsRHRuNQpZUnrxqh
# RESEND_FROM_EMAIL=founder.asa@gmail.com
# CONTACT_FORM_TO_EMAIL=
